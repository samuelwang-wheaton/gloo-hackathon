<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Join Simulation</title>
  <link rel="stylesheet" href="/styles.css" />
</head>
<body class="app-background">
  <main class="join-shell">
    <section class="join-card">
      <div class="section-kicker">Student Entry</div>
      <h1>Join Humanitarian Leadership Simulation</h1>
      <p>
        Enter your simulation code to begin the Tearfund Country Response Lead exercise.
      </p>

      <% if (error) { %>
        <div class="error-box"><%= error %></div>
      <% } %>

      <form action="/join" method="POST" class="form-stack">
        <label>
          Name
          <input name="name" type="text" required placeholder="Jamie Goodwin" />
        </label>

        <label>
          Email
          <input name="email" type="email" required placeholder="student@example.edu" />
        </label>

        <label>
          Team Name
          <input name="teamName" type="text" placeholder="Optional" />
        </label>

        <label>
          Join Code
          <input name="joinCode" type="text" required placeholder="Enter code from facilitator" />
        </label>

        <button class="primary-button full" type="submit">Enter Simulation</button>
      </form>

      <a href="/" class="back-link">← Back to homepage</a>
    </section>
  </main>
</body>
</html>