<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Humanitarian Leadership Simulation</title>
  <link rel="stylesheet" href="/styles.css" />
</head>
<body class="page-shell">
  <main class="laptop-frame">
    <header class="top-nav">
      <div class="brand-row">
        <div class="wheaton-mark">W</div>
        <div>
          <div class="brand-title">WHEATON COLLEGE</div>
          <div class="brand-subtitle">For Christ & His Kingdom</div>
        </div>
        <div class="brand-divider"></div>
        <div class="tearfund-mark">Tearfund</div>
      </div>

      <nav class="nav-links">
        <a href="/" class="active">HOME</a>
        <a href="/join">SCENARIOS</a>
        <a href="/facilitator">FACILITATOR</a>
        <span class="user-icon">●</span>
      </nav>
    </header>

    <section class="hero">
      <div class="hero-overlay"></div>

      <div class="hero-content">
        <p class="eyebrow">Humanitarian Response Coordinator</p>
        <h1>
          <span>LEAD with faith</span>
          UNDER PRESSURE
        </h1>
        <p class="hero-copy">
          Step into a humanitarian leadership role in South Sudan. Navigate crisis leadership,
          prioritizing complex ethical choices, coordinating between agencies, and accountability
          to affected populations by making timely decisions with unexpected developments along the way.
        </p>

        <div class="hero-actions">
          <a href="/join" class="primary-button">Join Simulation</a>
          <a href="/facilitator" class="secondary-button">Facilitator Dashboard</a>
        </div>
      </div>

      <div class="floating-status">
        <article>
          <div class="tile-image warm"></div>
          <div>
            <strong>SOUTH SUDAN</strong>
            <span>Gender-Based Violence & Floods</span>
          </div>
        </article>

        <article>
          <div class="tile-image teal"></div>
          <div>
            <strong>YOUR ROLE:</strong>
            <span>Tearfund Country Response Lead</span>
          </div>
        </article>

        <article>
          <div class="tile-image slate"></div>
          <div>
            <strong>YOUR PROGRESS</strong>
            <span>0% Complete in 0 of 90 Minutes</span>
          </div>
        </article>
      </div>
    </section>
  </main>
</body>
</html>